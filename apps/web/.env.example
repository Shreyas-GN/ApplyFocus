# ─── Authentication (Supabase-compatible Auth SDK) ───────────────────────────
# If using Neon Auth: set NEXT_PUBLIC_SUPABASE_URL to your Neon Auth endpoint.
# If using Supabase: set NEXT_PUBLIC_SUPABASE_URL to your Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Transaction pooler (port 6543) — used by Next.js serverless runtime.
# For Neon: ep-xxx-pooler.region.aws.neon.tech:6543
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech:6543/dbname?sslmode=require

# Direct / session connection — used by Drizzle Kit for schema migrations.
# For Neon: ep-xxx.region.aws.neon.tech:5432
DATABASE_MIGRATION_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech:5432/dbname?sslmode=require

# ─── File Storage ─────────────────────────────────────────────────────────────
# Resume files are stored in Supabase Storage (or S3-compatible service).
# SUPABASE_SECRET_KEY above is used by the admin client for storage operations.

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI (Anthropic) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ─── Cron Job Auth ────────────────────────────────────────────────────────────
# Random secret to authenticate Vercel Cron job requests
CRON_SECRET=
