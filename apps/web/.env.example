# Neon Database Connection Strings (PostgreSQL)
# Pooled connection string for Next.js runtime (serverless)
DATABASE_URL=postgresql://neondb_owner:password@ep-your-project-pooler.region.neon.tech/neondb?sslmode=require
# Direct connection string for Drizzle Kit migrations
DATABASE_MIGRATION_URL=postgresql://neondb_owner:password@ep-your-project.region.neon.tech/neondb?sslmode=require

# Neon Auth Configuration
NEON_AUTH_BASE_URL=https://your-auth-domain.neon.tech
NEON_AUTH_COOKIE_SECRET=your-32-character-secret-key-here

# App URL for redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic (AI Resume Parsing & Tailoring)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Vercel Cron / Protected Job Ingestion
CRON_SECRET=

