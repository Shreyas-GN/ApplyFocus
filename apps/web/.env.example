# Authentication (in-house, stored in the app database)
# Derives per-session CSRF tokens. Min 32 chars: openssl rand -base64 32
AUTH_SECRET=

# Transactional email (verification + password reset) via Resend.
# Free tier: 3,000 emails/month, 100/day. https://resend.com/api-keys
# Unset in development = emails are printed to the server console instead.
# Without a verified sending domain Resend only delivers to your own account
# email; verify a domain and set EMAIL_FROM to send to anyone.
RESEND_API_KEY=
EMAIL_FROM=ApplyPilot <onboarding@resend.dev>

# Supabase Storage (private resume files ONLY - not used for authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# Database Connection Strings (Postgres)
# Transaction pooler (port 6543) for Next.js runtime (serverless)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# Direct / Session pooler (port 5432) for Drizzle Kit migrations
DATABASE_MIGRATION_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# App URL for redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenRouter (AI Resume Parsing & Tailoring)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Vercel Cron / Protected Job Ingestion
CRON_SECRET=
