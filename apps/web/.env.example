# Authentication (in-house, stored in the app database)
# Derives per-session CSRF tokens. Min 32 chars: openssl rand -base64 32
AUTH_SECRET=

# Transactional email (verification + password reset) via Resend.
# Free tier: 3,000 emails/month, 100/day. https://resend.com/api-keys
# Unset in development = emails are printed to the server console instead.
# Without a verified sending domain Resend only delivers to your own account
# email; verify a domain and set EMAIL_FROM to send to anyone.
RESEND_API_KEY=
EMAIL_FROM=ApplyPilot <onboarding@resend.dev>

# Cloudflare R2 Storage (private resume files ONLY - not used for authentication)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=applyfocus-resumes

# Database Connection Strings (Neon Postgres)
# Pooled connection string (PgBouncer in transaction mode) for Next.js runtime (serverless)
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
# Direct / Non-pooled connection string for Drizzle Kit migrations
DATABASE_MIGRATION_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require

# App URL for redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenRouter (AI Resume Parsing & Tailoring)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Vercel Cron / Protected Job Ingestion
CRON_SECRET=

# Cloudflare Turnstile (Bot & Brute-force Protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
