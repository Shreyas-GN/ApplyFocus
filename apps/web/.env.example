# Neon Auth (Stack Auth) Configuration
# Get these from your Stack Auth project dashboard at https://app.stack-auth.com
NEXT_PUBLIC_STACK_PROJECT_ID=your-project-id
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=your-publishable-client-key
STACK_SECRET_SERVER_KEY=your-secret-server-key

# Neon PostgreSQL Connection Strings
# Transaction pooler (port 5432) for Next.js runtime (serverless)
DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
# Direct connection for Drizzle Kit migrations
DATABASE_MIGRATION_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require

# App URL for redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenRouter (AI Resume Parsing & Tailoring)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Vercel Cron / Protected Job Ingestion
CRON_SECRET=
